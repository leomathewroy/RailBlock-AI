# =================================================
# RailBlock AI - Environment Configuration
# =================================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
# =================================================

# Database
DATABASE_URL=postgresql+asyncpg://railblock:changeme@localhost:5432/railblock_ai
DATABASE_URL_SYNC=postgresql://railblock:changeme@localhost:5432/railblock_ai

# Security
SECRET_KEY=change-this-to-a-random-64-char-string
JWT_SECRET=change-this-to-a-different-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS - comma-separated origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Environment
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Demo User (for development only)
DEMO_USERNAME=Novaa_x
DEMO_PASSWORD=change-this-demo-password

# ML Model
MODEL_PATH=ml_models/delay_model
ENABLE_ML_PREDICTIONS=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5173

# Redis (optional, for production rate limiting)
# REDIS_URL=redis://localhost:6379/0
